# Configuração do Tork (RT-012). Copie para .env e ajuste; o .env não vai para o git.
# Todas as variáveis são opcionais: os valores abaixo são os padrões. Registro oficial: app/config.py.
# Não coloque senhas nem dados pessoais aqui.

# Caminho do banco SQLite (criado e migrado na primeira execução).
BANCO_SQLITE=data/loja.db

# false desliga a IA generativa: perguntas fora da base recebem resposta segura.
USAR_OLLAMA=true

# Endereço do Ollama (vazio = padrão do cliente, http://localhost:11434).
OLLAMA_HOST=

# Modelo usado nas respostas e na reescrita de contexto.
OLLAMA_MODELO=llama3.2

# Tempo máximo (s) de uma resposta da IA; depois disso, resposta segura (RT-010).
OLLAMA_TIMEOUT=45

# Tempo máximo (s) da reescrita de contexto; depois disso, usa a pergunta original.
OLLAMA_TIMEOUT_REESCRITA=10

# true reaproveita respostas da IA ainda não revisadas para perguntas quase idênticas (RT-002; padrão false desde D032).
TORK_SERVIR_SUGESTOES=false

# Antes de gerar, a IA classifica a pergunta; RISCO não é respondido pela IA (G27, D033).
TORK_CLASSIFICAR_RISCO=true
